NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string
MONGO_URI=your_mongodb_connection_string_here

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRE=30d

# Email (Gmail address + 16-character App Password, NOT your normal Gmail password)
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_char_app_password

# Default admin account (auto-created on first server start if no admin exists)
ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=set_a_strong_password

# Google Gemini (FREE tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_free_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# --- Cloudinary (image uploads) ---
# Free account: https://cloudinary.com -> Console -> Account Details
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Pusher (real-time chat/order notifications) ---
# Free account: https://dashboard.pusher.com -> Create app (Channels) ->
# App Keys tab has all four of these values.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

